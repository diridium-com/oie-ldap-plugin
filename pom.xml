<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.diridium</groupId>
    <artifactId>oie-ldap-plugin</artifactId>
    <version>${revision}</version>

    <name>LDAP Authentication</name>
    <packaging>pom</packaging>

    <properties>
        <revision>1.0.0</revision>

        <plugin.supported.mc.versions>${mc.version}</plugin.supported.mc.versions>

        <mc.version>4.7.0</mc.version>
        <!-- SHA-256 of the OIE distribution for mc.version (oie_unix_<version>.tar.gz), from
             the release's sha256sums file. scripts/install-engine-jars.sh checks the download
             against it before taking the engine jars from it. Update it with mc.version. -->
        <oie.dist.sha256>ab08558873dc6be1e474afaacc46efe94d29c945cd3381c10d0ae548ecb429de</oie.dist.sha256>
        <!-- The provided versions match what the engine ships, since that is what the
             plugin runs against. Re-check them on every mc.version bump. -->
        <slf4j.version>1.7.30</slf4j.version>
        <log4j.version>2.26.1</log4j.version>
        <javax-servlet.version>3.1.0</javax-servlet.version>
        <javax-rs-api.version>2.0.1</javax-rs-api.version>
        <swagger-annotations.version>2.0.10</swagger-annotations.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <!-- OperationUtil scans with Reflections; the engine ships reflections 0.9.10 with
             guava 32.0.1-jre and javassist 3.26.0-GA, so the tests use those versions too. -->
        <reflections.version>0.9.10</reflections.version>
        <guava.version>32.0.1-jre</guava.version>
        <javassist.version>3.26.0-GA</javassist.version>
        <junit5.version>5.10.2</junit5.version>
        <!-- Test only: the in-memory directory server. 7.0.5 was published 2026-06-11;
             7.0.6 (2026-11-02) is under the 14-day rule. -->
        <unboundid.version>7.0.5</unboundid.version>

        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Fixed entry times in the jars, so the same source builds the same bytes. -->
        <project.build.outputTimestamp>2026-10-08T00:00:00Z</project.build.outputTimestamp>

        <!-- Signing disabled by default. Use -Psigning to enable. -->
        <signing.skip>true</signing.skip>
    </properties>

    <profiles>
        <profile>
            <id>signing</id>
            <properties>
                <signing.skip>false</signing.skip>
                <signing.keystore>NONE</signing.keystore>
                <signing.storetype>PKCS11</signing.storetype>
                <signing.providerClass>sun.security.pkcs11.SunPKCS11</signing.providerClass>
                <signing.providerArg>${user.dir}/yubikey-pkcs11.cfg</signing.providerArg>
                <signing.alias>Certificate for PIV Authentication</signing.alias>
                <signing.storepass>${env.YUBIKEY_PIN}</signing.storepass>
                <signing.certchain>${user.dir}/certchain.pem</signing.certchain>
                <signing.tsa>http://timestamp.digicert.com</signing.tsa>
            </properties>
        </profile>
    </profiles>

    <organization>
        <name>Diridium Technologies Inc.</name>
        <url>https://diridium.com</url>
    </organization>

    <modules>
        <module>shared</module>
        <module>server</module>
        <module>package</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.7.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!-- Pin surefire: unpinned, Maven <= 3.8's super-POM binds a surefire old
                 enough to lack the JUnit Platform provider, which silently SKIPS the
                 entire JUnit 5 suite with a green build. Pinning 3.x guarantees the tests
                 actually run everywhere. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- 3.2.0 or later honours project.build.outputTimestamp. The default entries
                 (Built-By among them) are left out: they record the build machine's user. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultEntries>false</addDefaultEntries>
                        </manifest>
                        <manifestEntries>
                            <Application-Name>LDAP Authentication</Application-Name>
                            <url>https://diridium.com</url>
                            <authors>Diridium Technologies Inc.</authors>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
