<!-- Test logging. The plugin's logger runs at DEBUG so LogCapture sees every line;
     the console shows only warnings and errors. -->
<Configuration status="WARN">
    <Appenders>
        <Console name="console" target="SYSTEM_ERR">
            <PatternLayout pattern="%-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.diridium.ldap" level="debug" additivity="false">
            <AppenderRef ref="console" level="warn"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
